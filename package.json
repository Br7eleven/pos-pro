{
  "name": "nurture-pos-pro",
  "version": "1.0.0",
  "description": "Offline desktop POS for retail shops",
  "main": "out/main/index.js",
  "author": "Nurture POS",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
